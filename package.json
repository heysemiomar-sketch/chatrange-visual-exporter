{
  "name": "chatrange-visual-exporter",
  "version": "0.0.1",
  "private": true,
  "description": "A Manifest V3 extension for capturing selected AI conversation ranges as ordered high-resolution visual content.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "keywords": [
    "browser-extension",
    "manifest-v3",
    "chatgpt",
    "screenshot",
    "miro",
    "rtl",
    "arabic"
  ],
  "author": "Heysem Omar",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.37",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
