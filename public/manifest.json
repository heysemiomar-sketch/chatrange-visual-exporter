{
  "manifest_version": 3,
  "name": "ChatRange Visual Exporter",
  "version": "0.0.1",
  "description": "Select and export visual ranges from AI conversations.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Highlight a ChatGPT message"
  }
}
